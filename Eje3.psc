Algoritmo eJE2
	Definir Letra Como Caracter
	Escribir "Clasificacion de Letras por rango"
	Escribir sin Saltar "Digite una letra;"
	leer letra 
	Segun letra Hacer
		"A" O "a":
			Escribir "EXELENTE"
		"B" O "b":
			Escribir "BUENO"
		"C" O "c":
			Escribir "Regular"
		"D" O "d":
			Escribir "Deficiente"
		"F" O "f":
			Escribir "REPROBADO"
			De otro modo
			Escribir "Digite una letra valida entre A,B,C,D,F"
		
	FinSegun
	
FinAlgoritmo
